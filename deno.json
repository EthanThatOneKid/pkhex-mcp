{
  "lock": true,
  "version": "0.3.0",
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A --watch src/main.ts",
    "start": "deno run -A src/main.ts",
    "check": "deno check src/ tests/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env",
    "desktop": "deno desktop --hmr --allow-read --allow-net --allow-env --allow-run src/main.ts",
    "build:win": "deno desktop --compress=xz --target x86_64-pc-windows-msvc src/main.ts",
    "build:macos": "deno desktop --compress=xz --target aarch64-apple-darwin src/main.ts",
    "build:linux": "deno desktop --compress=xz --target x86_64-unknown-linux-gnu src/main.ts"
  },
  "imports": {
    "@/": "./",
    "hono": "npm:hono@^4",
    "@hono/zod-openapi": "npm:@hono/zod-openapi@^1",
    "@hono/swagger-ui": "npm:@hono/swagger-ui@^0.5",
    "@hono/mcp": "npm:@hono/mcp@^0.3",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^1",
    "ai": "npm:ai@^5",
    "@ai-sdk/openai-compatible": "npm:@ai-sdk/openai-compatible@^1",
    "zod": "npm:zod@^4",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/encoding": "jsr:@std/encoding@^1"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "desktop": {
    "app": {
      "name": "pkhex-mcp",
      "identifier": "com.ethanthatsomekid.pkhex-mcp"
    },
    "backend": "cef",
    "output": {
      "windows": "./dist/pkhex-mcp-v0.3.0-windows.msi",
      "macos": "./dist/pkhex-mcp-v0.3.0-macos.dmg",
      "linux": "./dist/pkhex-mcp-v0.3.0-linux.AppImage"
    }
  }
}
