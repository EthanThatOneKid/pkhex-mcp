{
  "lock": true,
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A --watch src/main.ts",
    "start": "deno run -A src/main.ts",
    "check": "deno check src/ tests/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "test": "deno test -A"
  },
  "imports": {
    "hono": "npm:hono@^4",
    "@hono/zod-openapi": "npm:@hono/zod-openapi@^1",
    "@hono/swagger-ui": "npm:@hono/swagger-ui@^0.5",
    "zod": "npm:zod@^4",
    "@std/assert": "jsr:@std/assert@^1"
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  }
}
